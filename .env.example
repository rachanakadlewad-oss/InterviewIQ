# ---------- LLM provider ----------
# demo      -> deterministic rule-based demo mode (NO API key, NOT real LLM reasoning)
# openai    -> any OpenAI-compatible /chat/completions endpoint (OpenAI, Groq, OpenRouter, Ollama, ...)
# anthropic -> Anthropic Messages API
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_MODEL=
# openai default: https://api.openai.com/v1   (Ollama example: http://localhost:11434/v1)
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
AGENT_MAX_RETRIES=2

# ---------- Scoring weights (documented in docs/ARCHITECTURE.md) ----------
WEIGHT_RESUME=0.4
WEIGHT_INTERVIEW=0.6
RECOMMEND_ADVANCE_MIN=70
RECOMMEND_REVIEW_MIN=50

# ---------- Shortlisting ----------
SHORTLIST_TOP_N=3
SHORTLIST_MIN_SCORE=40

# ---------- Interview limits (loop / repetition guards) ----------
MAX_QUESTIONS=8
MAX_FOLLOWUPS_PER_COMPETENCY=2
MAX_BROAD_PIVOTS=2
PLANNED_COMPETENCIES=4
MIN_COMPETENCIES_COVERED=3
MIN_QUESTIONS_BEFORE_CONCLUDE=4

# ---------- Identity verification ----------
# demo         -> DEMO ADAPTER: outcome chosen by an explicit scenario selector. NOT biometric verification.
# opencv_basic -> real face detection (Haar) + weak LBP-histogram similarity. NOT biometric grade.
IDENTITY_BACKEND=demo
IDENTITY_MATCH_THRESHOLD=0.70

# ---------- Misc ----------
DATA_DIR=./runtime
DATABASE_URL=sqlite:///./runtime/interviewiq.db
ENFORCE_SLOT_TIME=false
RECRUITER_API_KEY=
API_BASE_URL=http://127.0.0.1:8000
